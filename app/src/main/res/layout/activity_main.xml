<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0f3460"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OilPalm Harvester"
            android:textColor="#00d4ff"
            android:textSize="18sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/tvHarvesterId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID: -"
            android:textColor="#aaaaaa"
            android:textSize="14sp"
            android:paddingEnd="8dp"/>
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="?"
            android:textSize="16sp"
            android:backgroundTint="#1a1a2e"
            android:textColor="#aaaaaa"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/panelLog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="0dp"
            android:visibility="visible">
            <!-- Today Summary Card -->
            <LinearLayout
                android:id="@+id/cardToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0f3460"
                android:padding="20dp"
                android:layout_margin="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TODAY"
                    android:textColor="#00d4ff"
                    android:textSize="13sp"
                    android:letterSpacing="0.15"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/tvTodaySummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No entries yet"
                    android:textColor="#ffffff"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>

            <!-- Big New Entry Button -->
            <Button
                android:id="@+id/btnNewEntry"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_margin="16dp"
                android:text="+ NEW ENTRY"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#1a1a2e"
                android:backgroundTint="#00d4ff"
                android:letterSpacing="0.05"/>

            <!-- Quick stats row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:id="@+id/statCardRipe"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#0a2040"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:id="@+id/tvStatRipe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#00d4ff"
                        android:textSize="28sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RIPE"
                        android:textColor="#aaaaaa"
                        android:textSize="13sp"
                        android:letterSpacing="0.1"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/statCardEmpty"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#0a2040"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:id="@+id/tvStatEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#ffffff"
                        android:textSize="28sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMPTY"
                        android:textColor="#aaaaaa"
                        android:textSize="13sp"
                        android:letterSpacing="0.1"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <ScrollView
            android:id="@+id/panelRecords"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/recordsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"/>
        </ScrollView>

        <LinearLayout
            android:id="@+id/panelCalendar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/tvCalendarMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00d4ff"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:text="Month View"/>
            <GridLayout
                android:id="@+id/calendarGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="7"/>
            <LinearLayout
                android:id="@+id/analyticsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="24dp"/>
        </LinearLayout>

        <ScrollView
            android:id="@+id/panelSync"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RNS Sync"
                    android:textColor="#00d4ff"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="BLUETOOTH DEVICE" android:textColor="#aaaaaa" android:textSize="13sp"
                    android:layout_marginBottom="4dp"/>
                <Spinner
                    android:id="@+id/spinnerDevices"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="8dp"
                    android:popupBackground="#0f3460"
                    android:background="#0f3460"
                    android:padding="4dp"
                    />
                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="Connect to RNode"
                    android:backgroundTint="#0f3460"
                    android:textColor="#00d4ff"
                    android:layout_marginBottom="8dp"/>
                <Button
                    android:id="@+id/btnAnnounce"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Broadcast My Address"
                    android:backgroundTint="#1a3a1a"
                    android:textColor="#00d4ff"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/tvMyAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not connected"
                    android:textColor="#aaaaaa"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="24dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="BASE STATION ADDRESS" android:textColor="#aaaaaa" android:textSize="13sp"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:id="@+id/tvBaseStationAddr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Not set - go to Settings"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="24dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PENDING SYNC" android:textColor="#aaaaaa" android:textSize="13sp"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:id="@+id/tvUnsyncedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#ffffff"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnSyncNow"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Sync Now"
                    android:backgroundTint="#00d4ff"
                    android:textColor="#1a1a2e"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:enabled="false"
                    android:layout_marginBottom="16dp"/>
                <Button
                    android:id="@+id/btnSendPhotos"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Send Photos via Bluetooth"
                    android:backgroundTint="#0f3460"
                    android:textColor="#00d4ff"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvSyncLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#aaaaaa"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="8dp"/>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0f3460"
        android:orientation="horizontal">
        <Button android:id="@+id/btnNavLog"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="Log" android:textSize="13sp" android:textColor="#1a1a2e"
            android:backgroundTint="#00d4ff"/>
        <Button android:id="@+id/btnNavRecords"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="Records" android:textSize="13sp" android:textColor="#ffffff"
            android:backgroundTint="#0f3460"/>
        <Button android:id="@+id/btnNavCalendar"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="Calendar" android:textSize="13sp" android:textColor="#ffffff"
            android:backgroundTint="#0f3460"/>
        <Button android:id="@+id/btnNavSync"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="Sync" android:textSize="13sp" android:textColor="#ffffff"
            android:backgroundTint="#0f3460"/>
    </LinearLayout>

</LinearLayout>














