<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New Harvest Entry"
            android:textColor="#00d4ff"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Block ID" android:textColor="#aaaaaa" android:textSize="12sp"/>
        <EditText
            android:id="@+id/etBlockId"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="e.g. BLK-042"
            android:textColor="#ffffff"
            android:textColorHint="#555555"
            android:backgroundTint="#0f3460"
            android:inputType="text"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ripe Bunches" android:textColor="#aaaaaa" android:textSize="12sp"/>
        <EditText
            android:id="@+id/etRipeBunches"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="0"
            android:textColor="#ffffff"
            android:textColorHint="#555555"
            android:backgroundTint="#0f3460"
            android:inputType="number"
            android:textSize="24sp"
            android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Empty Bunches" android:textColor="#aaaaaa" android:textSize="12sp"/>
        <EditText
            android:id="@+id/etEmptyBunches"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="0"
            android:textColor="#ffffff"
            android:textColorHint="#555555"
            android:backgroundTint="#0f3460"
            android:inputType="number"
            android:textSize="24sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvGpsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GPS: waiting..."
            android:textColor="#aaaaaa"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnTakePhoto"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Take Photo (Required)"
            android:backgroundTint="#0f3460"
            android:textColor="#00d4ff"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <ImageView
            android:id="@+id/ivPhotoPreview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnSaveEntry"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Save Entry"
            android:backgroundTint="#00d4ff"
            android:textColor="#1a1a2e"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Cancel"
            android:backgroundTint="#0f3460"
            android:textColor="#aaaaaa"/>

    </LinearLayout>
</ScrollView>
