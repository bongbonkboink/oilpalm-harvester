<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textColor="#00d4ff"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Harvester ID" android:textColor="#aaaaaa" android:textSize="12sp"/>
    <EditText
        android:id="@+id/etHarvesterId"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:textColor="#ffffff"
        android:textColorHint="#555555"
        android:backgroundTint="#0f3460"
        android:inputType="text"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Base Station RNS Address" android:textColor="#aaaaaa" android:textSize="12sp"/>
    <EditText
        android:id="@+id/etBaseStation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="e.g. a1b2c3d4e5f6..."
        android:textColor="#ffffff"
        android:textColorHint="#555555"
        android:backgroundTint="#0f3460"
        android:inputType="text"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:layout_marginBottom="8dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="The LXMF address of the receiving base station"
        android:textColor="#555555"
        android:textSize="11sp"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Save Settings"
        android:backgroundTint="#00d4ff"
        android:textColor="#1a1a2e"
        android:textSize="16sp"
        android:textStyle="bold"/>

</LinearLayout>
